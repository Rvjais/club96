# Copy this file to server/.env and fill in the values.

# MongoDB Atlas → your cluster → Connect → Drivers → copy the connection string.
# Replace <db_password> with your database user's password; the database name goes before the "?".
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/viccky?retryWrites=true&w=majority

# Admin panel login (created on first start; changing ADMIN_PASSWORD updates it).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# Session signing key. Required in production — use a long random string.
# JWT_SECRET=

# PORT=4000
